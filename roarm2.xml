            <body name="gripper_link" pos="0.002906 -0.21599 -0.00066683" euler="-1.5708 0 -1.5708">
              <joint name="link3_to_gripper_link" type="hinge" axis="0 0 1" range="0 1.5" damping="0.05"/>
              <inertial pos="0.029 0.0027 -0.00078" mass="0.0028708" diaginertia="5.23216e-07 1.82071e-06 1.60231e-06"/>
              <geom name="gripper_link_geom" type="mesh" mesh="gripper_link_mesh" material="silver"/>
            </body>

            <body name="hand_tcp" pos="0.002 -0.2802 0" euler="1.5708 0 -1.5708"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="servo_base" joint="base_link_to_link1" kp="20"/>
    <position name="servo_shoulder" joint="link1_to_link2" kp="20"/>
    <position name="servo_elbow" joint="link2_to_link3" kp="20"/>
    <position name="servo_gripper" joint="link3_to_gripper_link" kp="10"/>
  </actuator>
</mujoco>
