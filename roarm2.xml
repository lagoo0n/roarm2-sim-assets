      <body name="link1" pos="0.0100000008759151 0 0.123059270461044">
        <joint name="base_link_to_link1" type="hinge" axis="0 0 1" range="-3.1416 3.1416" damping="0.05"/>
        <inertial pos="0 0 -0.015" mass="0.0729177" diaginertia="4.68465e-05 3.32107e-05 5.01023e-05"/>
        <geom name="link1_geom" type="mesh" mesh="link1_mesh" material="silver"/>

        <body name="link2" pos="0 0 0" euler="-1.5708 -1.5708 0">
          <joint name="link1_to_link2" type="hinge" axis="0 0 1" range="-1.5708 1.5708" damping="0.05"/>
          <inertial pos="0.122 0 0" mass="0.0703216" diaginertia="5.46501e-05 0.000423091 0.000404557"/>
          <geom name="link2_geom" type="mesh" mesh="link2_mesh" material="silver"/>

          <body name="link3" pos="0.236815132922094 0.0300023995170449 0" euler="0 0 1.5708">
            <joint name="link2_to_link3" type="hinge" axis="0 0 1" range="-1 2.95" damping="0.05"/>
